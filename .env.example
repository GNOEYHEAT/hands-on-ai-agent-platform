# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 .gitignore에 있어 저장소에 올라가지 않는다.
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 Gemini API 키
GOOGLE_API_KEY=

# 모델 ID. 키 없이 해 보려면 mock(모의 모델)으로 바꾼다.
DOC_AGENT_MODEL=gemini-3.5-flash-lite

# Frontend(CopilotKit 런타임)가 연결할 AG-UI 엔드포인트
ADK_AG_UI_URL=http://localhost:8000/ag-ui
